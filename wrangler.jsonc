{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babymeals",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baby-cube-db",
      "database_id": "여기에_D1_ID_입력"
    }
  ]
}
